<Window x:Class="PhotoViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Settings" AutomationProperties.Name="PhotoViewer settings" Height="640" Width="540" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="ThemeComboBoxToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3,28,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" />

                            <ToggleButton x:Name="DropDownToggle"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Style="{StaticResource ThemeComboBoxToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{DynamicResource TextForeground}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Width="10"
                                          Height="6" />
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,2,0,0"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource TextForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24" KeyboardNavigation.TabNavigation="Local">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextForeground}" />
            <TextBlock Text="Personalize PhotoViewer and control gallery behavior."
                       Margin="0,6,0,24" Foreground="{DynamicResource SubtleTextForeground}" />

            <TextBlock Text="Personalization" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,12" Foreground="{DynamicResource TextForeground}" />
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="App theme" Foreground="{DynamicResource TextForeground}" />
                    <TextBlock Text="Choose light, dark, or follow Windows." Margin="0,4,0,8"
                               Foreground="{DynamicResource SubtleTextForeground}" />
                    <ComboBox x:Name="ThemeComboBox" Width="220" HorizontalAlignment="Left"
                              Style="{StaticResource ThemeComboBoxStyle}"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="System" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Gallery" FontSize="18" FontWeight="SemiBold"
                       Margin="0,28,0,12" Foreground="{DynamicResource TextForeground}" />
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Default media view" Foreground="{DynamicResource TextForeground}" />
                    <ComboBox ItemsSource="{Binding MediaTypeOptions}" SelectedItem="{Binding SelectedMediaType}"
                              Width="180" HorizontalAlignment="Left" Margin="0,6,0,14"
                              Style="{StaticResource ThemeComboBoxStyle}" AutomationProperties.Name="Default thumbnail size" />
                    <TextBlock Text="Sort order" Foreground="{DynamicResource TextForeground}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                                  Width="150" Style="{StaticResource ThemeComboBoxStyle}" />
                        <ComboBox ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SelectedSortDirection}"
                                  Width="130" Margin="8,0,0,0" Style="{StaticResource ThemeComboBoxStyle}" />
                    </StackPanel>
                    <TextBlock Text="Thumbnail size" Foreground="{DynamicResource TextForeground}" />
                    <ComboBox ItemsSource="{Binding ThumbnailSizeOptions}" SelectedItem="{Binding ThumbnailRowHeight}"
                              Width="100" HorizontalAlignment="Left" Margin="0,6,0,0"
                              Style="{StaticResource ThemeComboBoxStyle}" AutomationProperties.Name="Default viewer zoom" />
                    <TextBlock Text="Default viewer zoom" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextForeground}" />
                    <ComboBox ItemsSource="{Binding ViewerZoomOptions}" SelectedItem="{Binding DefaultViewerZoom}"
                              Width="100" HorizontalAlignment="Left" Margin="0,6,0,0"
                              Style="{StaticResource ThemeComboBoxStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Viewer and privacy" FontSize="18" FontWeight="SemiBold"
                       Margin="0,28,0,12" Foreground="{DynamicResource TextForeground}" />
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel>
                    <CheckBox Content="Confirm before moving files to the Recycle Bin"
                              IsChecked="{Binding ConfirmDelete}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,12" AutomationProperties.Name="Confirm before moving files to the Recycle Bin" />
                    <CheckBox Content="Enable mouse-wheel zoom in the viewer"
                              IsChecked="{Binding MouseWheelZoom}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,12" AutomationProperties.Name="Enable mouse-wheel zoom in the viewer" />
                    <CheckBox Content="Show file location in image information"
                              IsChecked="{Binding ShowFileLocation}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,12" AutomationProperties.Name="Show file location in image information" />
                    <Separator Margin="0,14,0,12" />
                    <TextBlock Text="Privacy" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}" />
                    <TextBlock Text="PhotoViewer does not collect personal photos or browsing history. These optional settings are off by default."
                               TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource SubtleTextForeground}" />
                    <CheckBox Content="Allow anonymous diagnostics if I explicitly submit them"
                              IsChecked="{Binding AllowAnonymousDiagnostics}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10" AutomationProperties.Name="Allow anonymous diagnostics when explicitly submitted" />
                    <CheckBox Content="Enable personalized feature suggestions"
                              IsChecked="{Binding PersonalizedExperiences}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10" AutomationProperties.Name="Enable personalized feature suggestions" />
                    <CheckBox Content="Reduce motion and animation"
                              IsChecked="{Binding ReduceMotion}" Foreground="{DynamicResource TextForeground}" AutomationProperties.Name="Reduce motion and animation" />
                </StackPanel>
            </Border>

            <TextBlock Text="Accounts and sources" FontSize="18" FontWeight="SemiBold"
                       Margin="0,28,0,12" Foreground="{DynamicResource TextForeground}" />
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Manage local folders from the Sources menu."
                               Foreground="{DynamicResource TextForeground}" TextWrapping="Wrap" />
                    <TextBlock Text="Phone import will appear here when supported."
                               Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextForeground}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="About" FontSize="18" FontWeight="SemiBold"
                       Margin="0,28,0,12" Foreground="{DynamicResource TextForeground}" />
            <TextBlock Text="PhotoViewer · Windows 11 Photos-inspired gallery"
                       Foreground="{DynamicResource SubtleTextForeground}" Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</Window>
